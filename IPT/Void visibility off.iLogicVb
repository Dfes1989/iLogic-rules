Sub Main()
    ' Get the active document
    Dim odoc As PartDocument
    odoc = ThisApplication.ActiveDocument

    ' Get all solid bodies in the part
    Dim solidBodies As SurfaceBodies
    solidBodies = odoc.ComponentDefinition.SurfaceBodies

    ' Loop through each solid body
    For Each body As SurfaceBody In solidBodies
        ' Convert the name to uppercase to handle any case variations (e.g., Suppress, suppress)
        Dim bodyNameUpper As String = body.Name.ToUpper()

        ' Check if the solid body name contains the word "VOID" or "SUPPRESS"
        If bodyNameUpper.Contains("VOID") OrElse bodyNameUpper.Contains("SUPPRESS") Then
            ' Turn off the visibility of the solid body
            body.Visible = False
        End If
    Next

    ' Update the document to reflect changes
    odoc.Update()

    MessageBox.Show("Visibility turned off for all solids containing 'Void' or 'SUPPRESS' in their names.", "Operation Complete")
End Sub